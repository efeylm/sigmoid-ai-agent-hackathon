APP_NAME=Sigmoid AI Agent API
APP_VERSION=1.0.0
DEBUG=True

# docker-compose overrides this for the backend container
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_agent_db
DB_ECHO=False

# --- LLM (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-6-luna
# gpt-6-luna: tool calling over Chat Completions needs reasoning_effort=none.
# Leave empty for models that do not support reasoning_effort.
OPENAI_REASONING_EFFORT=none
# Only enable for models that accept a custom temperature.
OPENAI_SEND_TEMPERATURE=false

# --- Web search ---
TAVILY_API_KEY=your_tavily_api_key

# --- Ticaret Sicil Gazetesi login ---
SICIL_USER=your_sicil_gazetesi_email
SICIL_PASS=your_sicil_gazetesi_password

# Frontend -> backend URL as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (Oracle Cloud VM, docker-compose.prod.yml) ---
# Public hostname for HTTPS, e.g. 130-61-12-34.sslip.io (deploy/setup.sh fills this in)
DOMAIN=
# Postgres password inside the VM (setup.sh generates one if empty)
POSTGRES_PASSWORD=
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=
# Allow all Vercel URLs incl. previews
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
